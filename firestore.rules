rules_version = '2';

// Nur diese Google-Konten dürfen die Daten lesen und ändern.
// Adressen klein schreiben, genau wie beim Google-Konto.
service cloud.firestore {
  match /databases/{database}/documents {
    function erlaubt() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ronny.schieler@gmail.com',
          'presidente73@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if erlaubt();
    }
  }
}
